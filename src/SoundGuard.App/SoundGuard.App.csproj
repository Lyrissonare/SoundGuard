<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SoundGuard.App</RootNamespace>
    <AssemblyName>SoundGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SoundGuard.App.App</StartupObject>
    <!-- WFAC010 (WinForms analyzer) fires because app.manifest declares DPI awareness,
         which is the correct mechanism for a WPF-primary app. WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundGuard.Core\SoundGuard.Core.csproj" />
  </ItemGroup>

  <!-- WPF and WinForms both define Application/UserControl/MessageBox/Brush/Color etc.
       Drop the WinForms/Drawing implicit usings to avoid ambiguity; the two files that actually
       use them (TrayIconService, IconFactory) already have explicit using directives. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
