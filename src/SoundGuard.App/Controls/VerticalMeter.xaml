<UserControl x:Class="SoundGuard.App.Controls.VerticalMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource MutedBrush}"/>

        <TextBlock x:Name="ValueText" Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,8"
                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>

        <Border x:Name="MeterTrack" Grid.Row="2" Width="34" HorizontalAlignment="Center"
                Background="#0F1216" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Rectangle x:Name="Bar" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                           RenderTransformOrigin="0.5,1" RadiusX="3" RadiusY="3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#3DD68C" Offset="0"/>
                            <GradientStop Color="#F2C14E" Offset="0.7"/>
                            <GradientStop Color="#F0655A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="MinText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text=" — " FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="MaxText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
